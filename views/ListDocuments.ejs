<%- include('partials/header', { title: 'Documentos - ' + vehiculo.patente }) %>
<%- include('partials/navbar') %>

<main class="container">

  <!-- Header con datos del vehículo -->
  <div class="vehiculo-header">
  
    <a href="/vehiculos" class="link-back">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      Volver a vehículos
    </a>
  
    <div class="vehiculo-header-row">
      <div class="vehiculo-header-info">
        <div class="vehiculo-header-top">
          <span class="patente-badge"><%= vehiculo.patente %></span>
          <h1 class="vehiculo-header-title"><%= vehiculo.marca %> <%= vehiculo.modelo %></h1>
          <% if (vehiculo.anio) { %>
            <span class="vehiculo-anio"><%= vehiculo.anio %></span>
          <% } %>
        </div>
        <p class="vehiculo-header-sub">Documentos del vehículo</p>
      </div>

          <div class="vehiculo-header-actions" style="display:flex; gap:.5rem;">
      <% if (user.rol === 'admin') { %>
        <a href="/documentos/tipos" class="btn btn-primary">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
          Tipos de documento
        </a>
      <% } %>
  
      <% if (user.rol === 'admin' || user.rol === 'editor') { %>
        <a href="/vehiculos/<%= vehiculo.id %>/documentos/agregar" class="btn btn-primary">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Subir documento
        </a>
      <% } %>
    </div>
  
  </div>

  <!-- Tabla documentos -->
  <% if (documentos.length === 0) { %>
    <div class="empty-state">
      <p>Este vehículo no tiene documentos registrados.</p>
      <% if (user.rol === 'admin' || user.rol === 'editor') { %>
        <a href="/vehiculos/<%= vehiculo.id %>/documentos/agregar"
           class="btn btn-primary" style="margin-top:1rem">
          + Subir primer documento
        </a>
      <% } %>
    </div>
  <% } else { %>
    <table class="tabla">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Tipo</th>
          <th>Emisión</th>
          <th>Vencimiento</th>
          <th>Subido por</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% documentos.forEach(d => { %>
          <%
            const hoy   = new Date()
            const vence = d.fecha_vencimiento ? new Date(d.fecha_vencimiento) : null
            const diff  = vence ? Math.ceil((vence - hoy) / (1000*60*60*24)) : null
            let rowClass = ''
            let icon     = ''
            if (diff !== null) {
              if (diff < 0)        { rowClass = 'vencido';  icon = '🔴' }
              else if (diff <= 30) { rowClass = 'proximo';  icon = '⚠️' }
              else                 { rowClass = 'vigente';  icon = '✅' }
            }
          %>
          <tr class="<%= rowClass %>">
            <td><%= d.nombre %></td>
            <td><%= d.tipo %></td>
            <td>
              <%= d.fecha_emision
                ? new Date(d.fecha_emision).toLocaleDateString('es-CL')
                : '—' %>
            </td>
            <td>
              <%= icon %>
              <%= vence ? vence.toLocaleDateString('es-CL') : '—' %>
              <% if (diff !== null && diff >= 0 && diff <= 30) { %>
                <span class="badge-warning">Vence en <%= diff %> días</span>
              <% } %>
              <% if (diff !== null && diff < 0) { %>
                <span class="badge-danger">Venció hace <%= Math.abs(diff) %> días</span>
              <% } %>
            </td>
            <td><%= d.subido_por || '—' %></td>
            <td class="acciones">
              <a href="/vehiculos/<%= vehiculo.id %>/documentos/descargar/<%= d.id %>"
                 class="btn btn-sm btn-info">
                ⬇️ Descargar
              </a>
              <% if (user.rol === 'admin') { %>
                <form method="POST"
                      action="/vehiculos/<%= vehiculo.id %>/documentos/eliminar/<%= d.id %>"
                      onsubmit="return confirm('¿Eliminar <%= d.nombre %>?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn btn-sm btn-danger">🗑️ Eliminar</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

</main>

<%- include('partials/footer') %>