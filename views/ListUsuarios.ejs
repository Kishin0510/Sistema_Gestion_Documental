<%- include('partials/header', { title: 'Usuarios' }) %>
<%- include('partials/navbar') %>

<main class="container">

  <div class="page-header">
    <div class="page-header-text">
      <h1 class="page-title">Usuarios</h1>
      <p class="page-subtitle"><%= pagination.total %> usuario<%= pagination.total !== 1 ? 's' : '' %> registrado<%= pagination.total !== 1 ? 's' : '' %></p>
    </div>
    <a href="/usuarios/agregar" class="btn btn-primary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Agregar usuario
    </a>
  </div>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <% if (usuarios.length === 0) { %>
    <div class="empty-state">
      <p class="empty-state-title">Sin usuarios registrados</p>
    </div>
  <% } else { %>
    <div class="tabla-wrapper">
      <table class="tabla">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Email</th>
            <th>Rol</th>
            <th>Estado</th>
            <th>Creado</th>
            <th class="th-acciones">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% usuarios.forEach(u => { %>
            <tr>
              <td>
                <%= u.nombre %>
                <% if (String(u.id) === String(user.id)) { %>
                  <span class="badge-info" style="margin-left:.4rem; font-size:.75rem;">Tú</span>
                <% } %>
              </td>
              <td class="td-muted"><%= u.email %></td>
              <td>
                <span class="badge-tabla"><%= u.rol %></span>
              </td>
              <td>
                <% if (u.activo) { %>
                  <span class="badge-accion accion-insert">Activo</span>
                <% } else { %>
                  <span class="badge-accion accion-delete">Inactivo</span>
                <% } %>
              </td>
              <td class="td-muted">
                <%= new Date(u.created_at).toLocaleDateString('es-CL') %>
              </td>
              <td class="acciones">
                <a href="/usuarios/editar/<%= u.id %>" class="btn-accion btn-accion-warning" title="Editar usuario">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  Editar
                </a>

                <% if (String(u.id) !== String(user.id)) { %>
                  <% if (u.activo) { %>
                    <form method="POST" action="/usuarios/desactivar/<%= u.id %>"
                          onsubmit="return confirm('¿Desactivar a <%= u.nombre %>? No podrá iniciar sesión hasta que lo reactives.')">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn-accion btn-accion-danger" title="Desactivar usuario">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="4.9" y1="4.9" x2="19.1" y2="19.1"/></svg>
                        Desactivar
                      </button>
                    </form>
                  <% } else { %>
                    <form method="POST" action="/usuarios/activar/<%= u.id %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn-accion btn-accion-info" title="Reactivar usuario">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                        Activar
                      </button>
                    </form>
                  <% } %>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <%- include('partials/pagination', { pagination, baseUrl: '/usuarios' }) %>

</main>

<%- include('partials/footer') %>
