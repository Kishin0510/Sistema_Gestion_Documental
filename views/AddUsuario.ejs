<%- include('partials/header', { title: usuario && usuario.id ? 'Editar Usuario' : 'Agregar Usuario' }) %>
<%- include('partials/navbar') %>

<main class="container">
  <div class="page-header">
    <div>
      <a href="/usuarios" class="link-back">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        Volver a usuarios
      </a>
      <h1>
        <%= usuario && usuario.id ? '✏️ Editar Usuario' : '👤 Agregar Usuario' %>
      </h1>
    </div>
  </div>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <div class="form-card">
    <form method="POST"
          action="<%= usuario && usuario.id ? '/usuarios/editar/' + usuario.id : '/usuarios/agregar' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="form-row">
        <div class="form-group">
          <label>Nombre completo *</label>
          <input type="text" name="nombre"
                 value="<%= usuario ? usuario.nombre : '' %>"
                 placeholder="Ej: Juan Pérez"
                 required />
        </div>
        <div class="form-group">
          <label>Email *</label>
          <input type="email" name="email"
                 value="<%= usuario ? usuario.email : '' %>"
                 placeholder="usuario@empresa.cl"
                 required />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>Rol *</label>
          <select name="rol_id" required>
            <option value="">— Selecciona rol —</option>
            <% roles.forEach(r => { %>
              <option value="<%= r.id %>"
                <%= usuario && String(usuario.rol_id) === String(r.id) ? 'selected' : '' %>>
                <%= r.nombre %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label><%= usuario && usuario.id ? 'Nueva contraseña' : 'Contraseña *' %></label>
          <input type="password" name="password"
                 placeholder="<%= usuario && usuario.id ? 'Dejar en blanco para no cambiarla' : 'Mínimo 6 caracteres' %>"
                 <%= usuario && usuario.id ? '' : 'required' %> />
          <% if (usuario && usuario.id) { %>
            <small style="color:#6b7280;">Déjala vacía si no quieres cambiar la contraseña actual.</small>
          <% } %>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">
          <%= usuario && usuario.id ? 'Guardar cambios' : 'Crear usuario' %>
        </button>
        <a href="/usuarios" class="btn btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</main>

<%- include('partials/footer') %>
