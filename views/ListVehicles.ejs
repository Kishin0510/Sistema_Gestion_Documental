<%- include('partials/header', { title: 'Vehículos' }) %>
<%- include('partials/navbar') %>

<main class="container">

  <!-- ── Encabezado de página ── -->
  <div class="page-header">
    <div class="page-header-text">
      <h1 class="page-title">Vehículos</h1>
      <p class="page-subtitle"><%= vehiculos.length %> vehículo<%= vehiculos.length !== 1 ? 's' : '' %> registrado<%= vehiculos.length !== 1 ? 's' : '' %></p>
    </div>
    <% if (user.rol === 'admin' || user.rol === 'editor') { %>
      <a href="/vehiculos/agregar" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Agregar vehículo
      </a>
    <% } %>
  </div>

  <!-- ── Estado vacío ── -->
  <% if (vehiculos.length === 0) { %>
    <div class="empty-state">
      <div class="empty-state-icon" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17H3a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1"/><path d="M17 17h2a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-1"/><path d="M5 9h14l-1.5-4.5A2 2 0 0 0 15.6 3H8.4a2 2 0 0 0-1.9 1.5L5 9Z"/><circle cx="7.5" cy="17" r="2.5"/><circle cx="16.5" cy="17" r="2.5"/></svg>
      </div>
      <p class="empty-state-title">Sin vehículos registrados</p>
      <p class="empty-state-body">Agrega el primer vehículo para comenzar a gestionar la flota.</p>
      <% if (user.rol === 'admin' || user.rol === 'editor') { %>
        <a href="/vehiculos/agregar" class="btn btn-primary">Agregar vehículo</a>
      <% } %>
    </div>

  <!-- ── Tabla ── -->
  <% } else { %>
    <div class="tabla-wrapper">
      <table class="tabla">
        <thead>
          <tr>
            <th>Patente</th>
            <th>Marca / Modelo</th>
            <th>Año</th>
            <th>Color</th>
            <th>Kilometraje</th>
            <th class="th-acciones">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% vehiculos.forEach(v => { %>
            <tr>
              <td>
                <span class="patente-badge"><%= v.patente %></span>
              </td>
              <td>
                <span class="vehiculo-marca"><%= v.marca %></span>
                <span class="vehiculo-modelo"><%= v.modelo %></span>
              </td>
              <td class="td-muted"><%= v.anio || '—' %></td>
              <td class="td-color">
                <% if (v.color) { %>
                  <div class="td-color-inner">
                    <span class="color-dot" data-color="<%= v.colorHex || '#aaaaaa' %>" aria-hidden="true"></span>
                    <%= v.color %>
                  </div>
                <% } else { %>
                  <span class="td-muted">—</span>
                <% } %>
              </td>
              <td class="td-muted">
                <%= v.kilometraje != null ? v.kilometraje.toLocaleString('es-CL') + ' km' : '—' %>
              </td>
              <td class="acciones">
                <a href="/vehiculos/<%= v.id %>/documentos" class="btn-accion btn-accion-info" title="Ver documentos">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                  Documentos
                </a>
                <% if (user.rol === 'admin' || user.rol === 'editor') { %>
                  <a href="/vehiculos/editar/<%= v.id %>" class="btn-accion btn-accion-warning" title="Editar vehículo">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    Editar
                  </a>
                <% } %>
                <% if (user.rol === 'admin') { %>
                  <form method="POST" action="/vehiculos/eliminar/<%= v.id %>"
                        onsubmit="return confirm('¿Eliminar el vehículo <%= v.patente %>? Esta acción no se puede deshacer.')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" class="btn-accion btn-accion-danger" title="Eliminar vehículo">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                      Eliminar
                    </button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

</main>

<%- include('partials/footer') %>
